# ============================================
# AI Agents SaaS Platform - Environment Variables
# ============================================
# 
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
#

# ============================================
# Stripe Configuration (Required for payments)
# ============================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Use test mode keys during development (they start with pk_test_ and sk_test_)

# Public key - safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Secret key - NEVER expose in browser, server-side only
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Webhook secret - Get from: https://dashboard.stripe.com/test/webhooks
# After creating a webhook endpoint pointing to: https://your-domain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ============================================
# Firebase Configuration (Required for authentication)
# ============================================
# Get from Firebase Console: Project Settings > General > Your apps
# This is a JSON string containing your Firebase config

NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"YOUR_API_KEY","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id","storageBucket":"your-project.appspot.com","messagingSenderId":"123456789","appId":"1:123456789:web:abcdef123456"}'

# Optional: Firebase Admin SDK service account (for server-side operations)
# Download from Firebase Console: Project Settings > Service Accounts
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'

# ============================================
# Alternative: Auth0 Configuration
# ============================================
# If using Auth0 instead of Firebase, uncomment and configure these:
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_CLIENT_ID=your_client_id
# AUTH0_CLIENT_SECRET=your_client_secret
# AUTH0_AUDIENCE=https://your-api-audience
# NEXT_PUBLIC_AUTH0_DOMAIN=your-domain.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id

# ============================================
# Next.js Configuration
# ============================================
# NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Optional: Database Configuration
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/aiagents
# MONGODB_URI=mongodb://localhost:27017/aiagents

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# Optional: Email Service (for notifications)
# ============================================
# SENDGRID_API_KEY=SG.xxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# Setup Instructions
# ============================================
#
# 1. STRIPE SETUP:
#    - Sign up at https://stripe.com
#    - Get test mode API keys from Dashboard > Developers > API keys
#    - Create webhook endpoint in Dashboard > Developers > Webhooks
#    - Point webhook to: https://your-domain.com/api/stripe/webhook
#    - Select events: checkout.session.completed, customer.subscription.*
#    - Copy webhook signing secret
#
# 2. FIREBASE SETUP:
#    - Create project at https://console.firebase.google.com
#    - Enable Authentication > Sign-in method > Email/Password
#    - Get config from Project Settings > General > Your apps
#    - Format as JSON string for NEXT_PUBLIC_FIREBASE_CONFIG
#
# 3. DEPLOYMENT (Vercel):
#    - Install Vercel CLI: npm i -g vercel
#    - Run: vercel
#    - Add environment variables in Vercel dashboard
#    - Redeploy after adding variables
#
# 4. LOCAL DEVELOPMENT:
#    - Copy this file to .env.local
#    - Fill in your values
#    - Run: npm run dev
#    - Access at http://localhost:3000
#
