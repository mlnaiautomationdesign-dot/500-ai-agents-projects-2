# AI Influencer Factory — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Pipeline Control ──────────────────────────────────────────────────────────
DRY_RUN=true                        # true = no live API posting; false = live

# ── LLM APIs ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...               # Required: GPT-4, DALL-E 3, TTS-1
ANTHROPIC_API_KEY=sk-ant-...        # Optional: Claude API

# ── Voice (ElevenLabs — optional) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=                 # Optional: ElevenLabs TTS
ELEVENLABS_VOICE_ID=                # Optional: ElevenLabs voice ID

# ── Twitter/X ─────────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Instagram (Meta Graph API) ────────────────────────────────────────────────
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ── Database (optional) ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./influencer_factory.db
